---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ui } from '../lib/ui';
import { url } from '../lib/catalog';
import SearchPanel from '../components/SearchPanel';
interface Props {
  title: string;
  description?: string;
  reader?: boolean;
  course?: string;
}
const { title, description = ui.library, reader = false, course } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title} · {ui.brand}</title>
    <script is:inline>
      try {
        const readSettings = () => {
          try {
            return JSON.parse(
              localStorage.getItem('course-reader-settings') || '{}',
            );
          } catch {
            return {};
          }
        };
        const media = matchMedia('(prefers-color-scheme: dark)');
        const applyTheme = () => {
          const theme = readSettings().theme || 'system';
          document.documentElement.dataset.theme =
            theme === 'system' ? (media.matches ? 'dark' : 'light') : theme;
        };
        applyTheme();
        media.addEventListener('change', applyTheme);
        const settings = readSettings();
        if (settings.fontSize)
          document.documentElement.style.setProperty(
            '--reader-font',
            settings.fontSize + 'px',
          );
        if (settings.lineHeight)
          document.documentElement.style.setProperty(
            '--reader-leading',
            String(settings.lineHeight),
          );
        if (settings.width)
          document.documentElement.style.setProperty(
            '--reader-width',
            settings.width + 'px',
          );
      } catch {}
    </script>
  </head>
  <body class:list={[reader && 'reader-page']}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {!reader && (
      <header class="site-header" data-pagefind-ignore>
        <a class="brand" href={url()}>
          <span class="brand-mark">K</span>
          {ui.brand}
        </a>
        <nav>
          <a href={url()}>{ui.library}</a>
          <button class="search-trigger" data-open-search>
            {ui.search}
            <kbd>/</kbd>
          </button>
          <button class="icon-button" data-toggle-theme aria-label={ui.theme}>
            ◐
          </button>
        </nav>
      </header>
    )}
    <slot />
    <SearchPanel client:idle course={course} base={import.meta.env.BASE_URL} />
    <script>
      import { ui } from '../lib/ui';
      document.querySelectorAll('[data-toggle-theme]').forEach((button) => {
        button.addEventListener('click', () => {
          const theme =
            document.documentElement.dataset.theme === 'dark'
              ? 'light'
              : 'dark';
          document.documentElement.dataset.theme = theme;
          try {
            const settings = JSON.parse(
              localStorage.getItem('course-reader-settings') || '{}',
            );
            localStorage.setItem(
              'course-reader-settings',
              JSON.stringify({ ...settings, theme }),
            );
          } catch {}
        });
      });
      document
        .querySelectorAll<HTMLAnchorElement>('[data-resume-course]')
        .forEach((link) => {
          try {
            const saved = JSON.parse(
              localStorage.getItem(
                'course-reader-last-' + link.dataset.resumeCourse,
              ) || 'null',
            );
            const root = link.dataset.courseRoot!;
            if (saved?.url?.startsWith(root)) {
              link.href = saved.url;
              link.textContent = ui.resume;
            }
          } catch {}
        });
    </script>
  </body>
</html>
