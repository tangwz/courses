---
import SiteLayout from '../layouts/SiteLayout.astro';
import BookCover from '../components/BookCover.astro';
import { getBooks, categoryNames, levelNames, courseUrl } from '../lib/catalog';
import { ui } from '../lib/ui';
const books = await getBooks();
const categories = [...new Set(books.map((book) => book.course.data.category))];
const totalLessons = books.reduce((n, book) => n + book.lessons.length, 0);
---

<SiteLayout title={ui.library}>
  <main id="main" class="library-shell">
    <section class="library-intro">
      <div>
        <p class="eyebrow">A LIBRARY FOR CURIOUS MINDS</p>
        <h1>{ui.library}</h1>
        <p class="intro-copy">
          {
            '\u628a\u77e5\u8bc6\u8fde\u6210\u4f53\u7cfb\uff0c\u4ece\u4e00\u672c\u4e66\u5f00\u59cb\u3002'
          }
        </p>
      </div>
      <div class="library-stats">
        <strong>{books.length}</strong>
        <span>{'\u95e8\u8bfe\u7a0b'}</span>
        <i></i>
        <strong>{totalLessons.toLocaleString()}</strong>
        <span>{'\u8282\u77e5\u8bc6'}</span>
      </div>
    </section>
    <div class="catalog-layout">
      <aside class="filter-panel" aria-label={ui.filters}>
        <div class="filter-heading">
          <h2>{ui.filters}</h2>
          <button id="reset-filters">{ui.reset}</button>
        </div>
        <fieldset>
          <legend>{ui.category}</legend>
          <label>
            <input type="radio" name="category" value="all" checked />
            {ui.all}
          </label>
          {categories.map((category) => (
            <label>
              <input type="radio" name="category" value={category} />
              {categoryNames[category] || category}
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>{ui.difficulty}</legend>
          <label>
            <input type="radio" name="level" value="all" checked />
            {ui.all}
          </label>
          {[1, 2, 3, 4].map((level) => (
            <label>
              <input type="radio" name="level" value={level} />
              {levelNames[level]}
            </label>
          ))}
        </fieldset>
        <label class="sort-label" for="sort">
          {ui.sort}
        </label>
        <select id="sort">
          <option value="order">{ui.popular}</option>
          <option value="duration">{ui.shortest}</option>
          <option value="title">{ui.titleSort}</option>
        </select>
        <p class="filter-note">
          {
            '\u6bcf\u95e8\u8bfe\u7a0b\uff0c\u90fd\u662f\u4e00\u672c\u53ef\u4ee5\u6162\u6162\u8bfb\u7684\u4e66\u3002'
          }
        </p>
      </aside>
      <section class="catalog-content">
        <div class="catalog-toolbar">
          <label class="catalog-search">
            <span>⌕</span>
            <input
              id="catalog-query"
              type="search"
              placeholder={ui.searchPlaceholder}
              aria-label={ui.search}
            />
            <kbd>/</kbd>
          </label>
          <span id="course-count" aria-live="polite">
            {books.length} {'\u95e8\u8bfe\u7a0b'}
          </span>
        </div>
        <div class="book-grid" id="book-grid">
          {books.map(({ course }) => (
            <article
              class="book-card"
              data-category={course.data.category}
              data-level={course.data.level}
              data-order={course.data.order}
              data-duration={course.data.duration}
              data-title={course.data.title}
              data-query={`${course.data.title} ${course.data.description} ${course.data.category} ${categoryNames[course.data.category] || ''}`.toLowerCase()}
            >
              <a
                class="cover-link"
                href={courseUrl(course.data.course)}
                tabindex="-1"
              >
                <BookCover
                  title={course.data.title}
                  category={course.data.category}
                  order={course.data.order}
                  color={course.data.color}
                />
              </a>
              <div class="book-card-content">
                <div class="tags">
                  <span>
                    {categoryNames[course.data.category] ||
                      course.data.category}
                  </span>
                  <span class="level-tag">{levelNames[course.data.level]}</span>
                </div>
                <h2>
                  <a href={courseUrl(course.data.course)}>
                    {course.data.title}
                  </a>
                </h2>
                <p>{course.data.description}</p>
                <div class="book-meta">
                  <span>
                    {course.data.chapterCount} {ui.chapter} ·{' '}
                    {course.data.lessonCount} {ui.lesson}
                  </span>
                  <span>
                    ◷ {course.data.duration} {ui.hours}
                  </span>
                </div>
                <a class="card-button" href={courseUrl(course.data.course)}>
                  {ui.show}
                  <span>↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
        <div id="no-courses" class="empty-state" hidden>
          {ui.empty}
        </div>
      </section>
    </div>
    <footer class="site-footer">
      <span>KNOWLEDGE LIBRARY</span>
      <a href="https://apxml.com/zh/courses" rel="noopener" target="_blank">
        {'\u5185\u5bb9\u6765\u6e90\uff1aApX'}
      </a>
    </footer>
  </main>
  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('.book-card')];
    const query = document.querySelector<HTMLInputElement>('#catalog-query')!;
    const sort = document.querySelector<HTMLSelectElement>('#sort')!;
    const grid = document.querySelector('#book-grid')!;
    function filter() {
      const category = document.querySelector<HTMLInputElement>(
        '[name=category]:checked',
      )!.value;
      const level = document.querySelector<HTMLInputElement>(
        '[name=level]:checked',
      )!.value;
      let count = 0;
      for (const card of cards) {
        card.hidden =
          !(category === 'all' || card.dataset.category === category) ||
          !(level === 'all' || card.dataset.level === level) ||
          !card.dataset.query!.includes(query.value.trim().toLowerCase());
        if (!card.hidden) count++;
      }
      cards
        .sort((a, b) =>
          sort.value === 'title'
            ? a.dataset.title!.localeCompare(b.dataset.title!, 'zh-CN')
            : Number(a.dataset[sort.value]) - Number(b.dataset[sort.value]),
        )
        .forEach((card) => grid.append(card));
      document.querySelector('#course-count')!.textContent =
        count + ' \u95e8\u8bfe\u7a0b';
      (document.querySelector('#no-courses') as HTMLElement).hidden = count > 0;
    }
    document
      .querySelectorAll('.filter-panel input, #sort')
      .forEach((input) => input.addEventListener('change', filter));
    query.addEventListener('input', filter);
    document.querySelector('#reset-filters')!.addEventListener('click', () => {
      document.querySelector<HTMLInputElement>(
        '[name=category][value=all]',
      )!.checked = true;
      document.querySelector<HTMLInputElement>(
        '[name=level][value=all]',
      )!.checked = true;
      query.value = '';
      sort.value = 'order';
      filter();
    });
  </script>
</SiteLayout>
