        "font": {
          "color": "white"
        }
      },
      {
        "x": 1,
        "y": 0,
        "text": "假阳性=50",
        "showarrow": false,
        "font": {
          "color": "#495057"
        }
      },
      {
        "x": 0,
        "y": 1,
        "text": "假阴性=100",
        "showarrow": false,
        "font": {
          "color": "#495057"
        }
      },
      {
        "x": 1,
        "y": 1,
        "text": "真阳性=1000",
        "showarrow": false,
        "font": {
          "color": "white"
        }
      }
