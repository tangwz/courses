      "title": "GPTQ: Accurate Post-Training Quantization for Generative Pretrained Transformers",
      "author": "Elias Frantar, Saleh Ashkboos, Torsten Hoefler, Dan Alistarh",
      "year": "2023",
      "publisher": "",
